# Optional public origin used when absolute application URLs are required.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only settings belong below this line. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=postgresql://creator_os:replace-me@127.0.0.1:5432/creator_os
DATABASE_POOL_SIZE=5

# Bootstrap values are used only by `npm run db:bootstrap-owner` and should not
# remain in a long-lived production environment file.
OWNER_EMAIL=owner@example.com
OWNER_DISPLAY_NAME=Owner
OWNER_PASSWORD=replace-with-at-least-12-characters
